{
  "manifest_version": 3,
  "name": "ASCII Animals New Tab",
  "short_name": "ASCII Animals",
  "version": "0.9.1",
  "description": "A live ASCII wildlife scene for your new tab: seven animals that react to clicks, with a glass search box.",
  "homepage_url": "https://github.com/akash-deepak-varma/ascii-animals",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "search"
  ],
  "optional_permissions": [
    "topSites",
    "bookmarks",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
