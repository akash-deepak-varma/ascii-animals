{
  "manifest_version": 3,
  "name": "ASCII Animals New Tab",
  "short_name": "ASCII Animals",
  "version": "1.0.0",
  "description": "A live ASCII wildlife scene for your new tab: butterflies, koi, jellyfish, dragonflies, frogs, cranes and crabs, with a glass search box.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "search"],
  "optional_permissions": ["topSites", "bookmarks"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
