{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src",
    "compare.ts",
    "demo.ts",
    "panel.ts",
    "ui.ts",
    "store.ts",
    "settings.ts",
    "shortcuts.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/react.tsx"
  ]
}
